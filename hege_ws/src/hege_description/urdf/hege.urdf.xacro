<?xml version="1.0"?>
<robot name="hege" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find hege_description)/urdf/hege_parameters.xacro"/>

  <material name="hege_orange"><color rgba="1.0 0.35 0.02 1.0"/></material>
  <material name="tyre_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
  <material name="sensor_blue"><color rgba="0.05 0.25 0.80 1.0"/></material>
  <material name="gps_white"><color rgba="0.90 0.90 0.90 1.0"/></material>

  <xacro:macro name="box_inertia" params="m x y z cx:=0 cy:=0 cz:=0">
    <inertial>
      <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_surface" params="link">
    <gazebo reference="${link}">
      <mu1>${wheel_mu_longitudinal}</mu1>
      <mu2>${wheel_mu_lateral}</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>10000000.0</kp>
      <kd>10000.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.5</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- Ground-projected 2-D navigation frame. -->
  <link name="base_footprint"/>

  <!-- Vehicle reference and aggregate centre of mass, 1.10 m above ground. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_visual_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="hege_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_visual_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${chassis_length}" y="${chassis_width}"
      z="${chassis_height}" cx="${base_inertial_x}" cz="${base_inertial_z}"/>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="rear_wheel" params="side y_sign">
    <link name="${side}_rear_wheel">
      <visual><geometry><cylinder radius="${rear_wheel_radius}" length="${wheel_width}"/></geometry><material name="tyre_black"/></visual>
      <collision><geometry><cylinder radius="${rear_wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <xacro:cylinder_inertia m="${rear_wheel_mass}" r="${rear_wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${side}_rear_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_rear_wheel"/>
      <origin xyz="${rear_axle_x} ${y_sign*rear_track/2.0} ${rear_axle_z}" rpy="-1.57079632679 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="${drive_effort_limit}" velocity="${rear_wheel_speed_limit}"/>
      <dynamics damping="0.20" friction="0.10"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel side="left" y_sign="1"/>
  <xacro:rear_wheel side="right" y_sign="-1"/>
  <xacro:wheel_surface link="left_rear_wheel"/>
  <xacro:wheel_surface link="right_rear_wheel"/>

  <xacro:macro name="front_wheel" params="side y_sign">
    <link name="${side}_steer_link">
      <inertial><mass value="${steer_link_mass}"/><inertia ixx="0.10" ixy="0" ixz="0" iyy="0.10" iyz="0" izz="0.10"/></inertial>
    </link>
    <joint name="${side}_steer_joint" type="revolute">
      <parent link="base_link"/><child link="${side}_steer_link"/>
      <origin xyz="${front_axle_x} ${y_sign*front_track/2.0} ${front_axle_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-max_steer}" upper="${max_steer}" effort="${steer_effort_limit}" velocity="${steer_rate_limit}"/>
      <dynamics damping="20.0" friction="10.0"/>
    </joint>
    <link name="${side}_front_wheel">
      <visual><geometry><cylinder radius="${front_wheel_radius}" length="${wheel_width}"/></geometry><material name="tyre_black"/></visual>
      <collision><geometry><cylinder radius="${front_wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <xacro:cylinder_inertia m="${front_wheel_mass}" r="${front_wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${side}_front_wheel_joint" type="continuous">
      <parent link="${side}_steer_link"/><child link="${side}_front_wheel"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="${drive_effort_limit}" velocity="${rear_wheel_speed_limit}"/>
      <dynamics damping="0.10" friction="0.05"/>
    </joint>
  </xacro:macro>

  <xacro:front_wheel side="left" y_sign="1"/>
  <xacro:front_wheel side="right" y_sign="-1"/>
  <xacro:wheel_surface link="left_front_wheel"/>
  <xacro:wheel_surface link="right_front_wheel"/>

  <link name="imu_link">
    <visual><geometry><box size="0.12 0.08 0.04"/></geometry><material name="sensor_blue"/></visual>
    <inertial><mass value="${sensor_mass}"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

  <link name="gps_link">
    <visual><geometry><cylinder radius="0.09" length="0.04"/></geometry><material name="gps_white"/></visual>
    <inertial><mass value="${sensor_mass}"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/><child link="gps_link"/>
    <origin xyz="${gps_x} ${gps_y} ${gps_z}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="gps_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on><update_rate>100.0</update_rate><visualize>false</visualize>
      <topic>/imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>${imu_gyro_noise}</stddev><bias_mean>${imu_gyro_bias}</bias_mean><bias_stddev>${imu_gyro_bias}</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>${imu_accel_noise}</stddev><bias_mean>${imu_accel_bias}</bias_mean><bias_stddev>${imu_accel_bias}</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat">
      <always_on>true</always_on><update_rate>5.0</update_rate><visualize>false</visualize>
      <topic>/gps/fix</topic>
      <navsat><position_sensing>
        <horizontal><noise type="gaussian"><mean>0</mean><stddev>${gps_horizontal_stddev}</stddev></noise></horizontal>
        <vertical><noise type="gaussian"><mean>0</mean><stddev>${gps_vertical_stddev}</stddev></noise></vertical>
      </position_sensing></navsat>
    </sensor>
  </gazebo>

  <ros2_control name="HegeGazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="left_rear_wheel_joint">
      <command_interface name="velocity"><param name="min">${-rear_wheel_speed_limit}</param><param name="max">${rear_wheel_speed_limit}</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="right_rear_wheel_joint">
      <command_interface name="velocity"><param name="min">${-rear_wheel_speed_limit}</param><param name="max">${rear_wheel_speed_limit}</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="left_steer_joint">
      <command_interface name="position"><param name="min">${-max_steer}</param><param name="max">${max_steer}</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="right_steer_joint">
      <command_interface name="position"><param name="min">${-max_steer}</param><param name="max">${max_steer}</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="left_front_wheel_joint"><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_front_wheel_joint"><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find hege_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
