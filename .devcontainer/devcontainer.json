{
  "name": "Hege ROS 2 Humble",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "ros",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/hege_gps_navigation,type=bind",
  "workspaceFolder": "/workspaces/hege_gps_navigation",
  "remoteUser": "ros",
  "updateRemoteUserUID": true,
  "runArgs": [
    "--network=host",
    "--ipc=host",
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--gpus=all"
  ],
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "QT_X11_NO_MITSHM": "1",
    "ROS_DOMAIN_ID": "0",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "all"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-vscode.cpptools",
        "redhat.vscode-xml"
      ],
      "settings": {
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    8765
  ]
}
