<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- VERIFIED MEASUREMENTS, metres/radians/kg. -->
  <xacro:property name="wheelbase" value="1.90"/>
  <xacro:property name="front_track" value="1.55"/>
  <xacro:property name="rear_track" value="1.55"/>
  <xacro:property name="front_wheel_radius" value="0.28"/>
  <xacro:property name="rear_wheel_radius" value="0.40"/>
  <xacro:property name="base_height" value="1.10"/>
  <xacro:property name="imu_height" value="1.20"/>
  <xacro:property name="gps_height" value="1.30"/>
  <xacro:property name="total_mass" value="1300.0"/>
  <xacro:property name="max_steer" value="0.610865238"/> <!-- 35 deg -->

  <!-- All three frames currently share the same measured vertical axis. -->
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="${imu_height-base_height}"/>
  <xacro:property name="gps_x" value="0.0"/>
  <xacro:property name="gps_y" value="0.0"/>
  <xacro:property name="gps_z" value="${gps_height-base_height}"/>

  <!-- APPROXIMATIONS: replace when CAD/scale measurements are available. -->
  <xacro:property name="chassis_length" value="2.20"/>
  <xacro:property name="chassis_width" value="1.35"/>
  <xacro:property name="chassis_height" value="0.50"/>
  <xacro:property name="chassis_visual_z" value="-0.15"/>
  <xacro:property name="wheel_width" value="0.20"/>
  <xacro:property name="rear_wheel_mass" value="35.0"/>
  <xacro:property name="front_wheel_mass" value="20.0"/>
  <xacro:property name="steer_link_mass" value="8.0"/>
  <xacro:property name="sensor_mass" value="0.10"/>
  <xacro:property name="base_mass"
    value="${total_mass-2*rear_wheel_mass-2*front_wheel_mass-2*steer_link_mass-2*sensor_mass}"/>

  <!-- Axle centres relative to base_link. Both tyres touch z=0. -->
  <xacro:property name="front_axle_x" value="${wheelbase/2.0}"/>
  <xacro:property name="rear_axle_x" value="${-wheelbase/2.0}"/>
  <xacro:property name="front_axle_z" value="${front_wheel_radius-base_height}"/>
  <xacro:property name="rear_axle_z" value="${rear_wheel_radius-base_height}"/>

  <!-- Make the aggregate model CoM coincide with base_link despite the
       approximate separate wheel/knuckle masses. -->
  <xacro:property name="moving_mass_moment_x"
    value="${2*rear_wheel_mass*rear_axle_x + 2*(front_wheel_mass+steer_link_mass)*front_axle_x}"/>
  <xacro:property name="moving_mass_moment_z"
    value="${2*rear_wheel_mass*rear_axle_z + 2*(front_wheel_mass+steer_link_mass)*front_axle_z + sensor_mass*imu_z + sensor_mass*gps_z}"/>
  <xacro:property name="base_inertial_x" value="${-moving_mass_moment_x/base_mass}"/>
  <xacro:property name="base_inertial_z" value="${-moving_mass_moment_z/base_mass}"/>

  <!-- PHYSICS STARTING VALUES: calibrate against measured real tests. -->
  <xacro:property name="steer_effort_limit" value="5000.0"/>
  <xacro:property name="steer_rate_limit" value="0.60"/> <!-- rad/s -->
  <xacro:property name="drive_effort_limit" value="3000.0"/>
  <xacro:property name="max_linear_speed" value="0.30"/>
  <xacro:property name="rear_wheel_speed_limit" value="${max_linear_speed/rear_wheel_radius}"/>
  <xacro:property name="wheel_mu_longitudinal" value="0.80"/>
  <xacro:property name="wheel_mu_lateral" value="1.00"/>
  <xacro:property name="wheel_slip" value="0.02"/>

  <!-- Sensor model: standalone GNSS and a typical MEMS IMU starting point. -->
  <xacro:property name="gps_horizontal_stddev" value="2.0"/>
  <xacro:property name="gps_vertical_stddev" value="4.0"/>
  <xacro:property name="imu_gyro_noise" value="2.0e-4"/>
  <xacro:property name="imu_accel_noise" value="1.7e-2"/>
  <xacro:property name="imu_gyro_bias" value="7.5e-6"/>
  <xacro:property name="imu_accel_bias" value="0.05"/>
</robot>
